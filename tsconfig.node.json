{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/core/**/*", "src/backend/**/*", "extension/src/**/*", "src/shared/**/*", "src/renderer/src/graph.ts", "src/renderer/src/shortcuts.ts", "src/renderer/src/layout.ts", "src/renderer/src/panes.ts", "src/renderer/src/order.ts", "src/renderer/src/mergeLayout.ts", "src/renderer/src/historyScope.ts", "src/renderer/src/dock.ts", "src/renderer/src/fileTree.ts", "src/renderer/src/cycle.ts", "src/renderer/src/stable.ts", "src/renderer/src/changesMode.ts", "src/renderer/src/changeEntries.ts", "src/renderer/src/editorText.ts", "src/renderer/src/analytics/model.ts", "src/renderer/src/analytics/metrics.ts", "src/renderer/src/savedLayouts.ts", "src/renderer/src/fileIcons.ts", "src/renderer/src/fileIcons.generated.ts", "tests/*.ts", "tests/support/**/*", "*.config.ts"]
}
